# Copy this file to .env and paste your real key.
# Never commit .env to GitHub.
ANTHROPIC_API_KEY=your-key-here

# Day 6 handoff alerts (optional; without them alerts print in the terminal)
# Telegram: create a bot with @BotFather, then run: python notify.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gmail: needs 2-Step Verification + an app password (not your normal password)
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# Day 7: websites allowed to embed the widget (comma-separated). Default * = any (dev only)
ALLOWED_ORIGINS=

# Day 8: security
# Password for /leads, /handoffs, /search. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=
# Optional limits (defaults: 20 messages per visitor per 10 min, 500 per day)
RATE_LIMIT_PER_IP=
DAILY_MESSAGE_CAP=
